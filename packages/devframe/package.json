{
  "name": "next-export-loader-devframe",
  "version": "0.1.0",
  "description": "Devframe hub dock panel for next-export-loader navigations",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "bin": {
    "next-export-loader-devframe": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@devframes/hub": "1.0.0",
    "@devframes/hub-ui": "1.0.0",
    "devframe": "1.0.0"
  },
  "peerDependencies": {
    "next": ">=13",
    "next-export-loader": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "next": "^14.2.0",
    "next-export-loader": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "next-export-loader",
    "devframe",
    "devtools"
  ],
  "license": "MIT"
}
